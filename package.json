{
  "name": "sky-climbers",
  "version": "0.1.0",
  "private": true,
  "description": "Sky Climbers — a pixel-art multiplayer tower-climbing game.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:capacity": "node scripts/load-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}

